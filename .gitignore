# ============================================================
# claw-agent 项目 .gitignore
# ============================================================

# ============ 构建产物 ============
**/target/
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/coverage/

# Maven 插件生成物
.flattened-pom.xml
dependency-reduced-pom.xml

# TypeScript 编译缓存
*.tsbuildinfo

# ============ AgentScope 运行时数据 ============
# 根目录 .agentscope（会话记录、记忆、技能缓存、笔记）
.agentscope/
# 后端 .agentscope（同上，运行时按租户/用户生成）
backend/.agentscope/

# ============ 用户上传文件 ============
/data/

# ============ 密钥与环境变量（安全规约：secret 不提交） ============
*.env
.env.*
!.env.example
*.pem

# ============ 日志 ============
*.log
/logs/

# ============ IDE / 编辑器 ============
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Vercel 部署缓存（前端）
.vercel

# ============ 操作系统 ============
.DS_Store
Thumbs.db
