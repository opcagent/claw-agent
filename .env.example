# ============================================================
# claw-agent 环境变量模板（开发环境）
# 复制此文件为 .env 并填写实际值，.env 文件已被 .gitignore 忽略
# ============================================================

# MySQL 数据库配置（必填）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=claw_agent
MYSQL_USER=root
MYSQL_PASSWORD=root

# Redis 配置（可选，不设置则使用本地 JSON 存储）
REDIS_HOST=172.16.1.251
REDIS_PORT=6379
REDIS_PASSWORD=energy666
REDIS_DB=0

# JWT 密钥（必填，生产环境必须使用强随机字符串）
CLAW_JWT_SECRET=a0c98809-d5ab-4e26-8bca-24ac8dddf110

# HTTP 代理配置（中国大陆网络环境下访问外网服务时需要）
HTTP_PROXY_HOST=
HTTP_PROXY_PORT=0

# CORS 跨域白名单（开发环境默认允许 localhost）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 上传目录配置
CLAW_UPLOAD_DIR=D:/claw-agent/data/uploads

# Agent 工作区配置
CLAW_AGENT_WORKSPACE=D:/claw-agent/.agentscope/workspace

# HikariCP 连接池配置（可选）
HIKARI_MAX_POOL=15
HIKARI_MIN_IDLE=5

# Redis 自动降级开关（auto/true/false）
REDIS_ENABLED=auto

# OCR API 配置（可选，不设置则使用数据库中的凭证）
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=
